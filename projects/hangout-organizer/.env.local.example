# hangout-organizer uses its OWN Supabase project — not the one shared by
# debt-tracker / reader-assistant. See CLAUDE.md for why.
#
# Local dev: copy this file to .env.local
# Vercel:    set the same vars in Project Settings -> Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

# Only this email may sign in as host. Everyone else is rejected at the callback.
HOST_EMAIL=chinwonyoon99@gmail.com

# Used to build share links (no trailing slash).
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web Push -------------------------------------------------------------
# Host-only notifications ("someone answered your poll"). Generate the pair once
# with `npx web-push generate-vapid-keys` and never rotate it: the public key is
# embedded in every subscription a browser has already made, so a new pair
# silently kills every registered device.
#
# The public key is deliberately NEXT_PUBLIC_ — the browser needs it to
# subscribe, and it authenticates the sender rather than authorising anything.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_generated_vapid_public_key_here
VAPID_PRIVATE_KEY=your_generated_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com
